# ========================================================
# MELHOR DA ILHA - HostGator Apache Configuration (.htaccess)
# ========================================================

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Roteamento Nativo para Hospedagem Compartilhada HostGator (Apache + PHP)
  # Encaminha todas as rotas /api/* para o motor PHP local (api.php)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} ^/api/(.*)$
  RewriteRule ^api/(.*)$ /api.php?endpoint=/api/$1 [QSA,L]

  # 2. Permite acesso direto ao api.php sem cair no SPA index.html
  RewriteRule ^api\.php$ - [L]

  # 3. SPA (Single Page Application) Routing:
  # Encaminha as demais rotas amigaveis (ex: /brotas, /perfil/...) para index.html
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !^/api(/|$)
  RewriteRule . /index.html [L]
</IfModule>

# Compressao GZIP / Deflate para carregamento ultra rapido
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# Cache de navegador para arquivos estaticos
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
</IfModule>

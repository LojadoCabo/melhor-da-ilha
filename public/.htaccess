# ========================================================
# MELHOR DA ILHA - HostGator Apache Configuration (.htaccess)
# ========================================================

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Reverse Proxy voor Node.js backend (indien mod_proxy actief is)
  # Stuurt alle /api verzoeken door naar de lokale Node.js server (standaard poort 3000)
  <IfModule mod_proxy.c>
    RewriteCond %{REQUEST_URI} ^/api/
    RewriteRule ^api/(.*)$ http://127.0.0.1:3000/api/$1 [P,L]
  </IfModule>

  # 2. Bescherming tegen HTML-fallback op API-routes:
  # Als Apache het verzoek verwerkt (en er geen Node reverse proxy is),
  # voorkom dat /api verzoeken naar index.html worden herschreven!
  # Dit lost de fout op: "Unexpected token '<', <!doctype... is not valid JSON"
  RewriteCond %{REQUEST_URI} ^/api(/|$)
  RewriteRule ^api/ - [R=404,L]
  ErrorDocument 404 "Not Found"

  # 3. SPA (Single Page Application) Routing:
  # Stuur alle overige routes (bijv. /brotas, /?business=123) naar index.html
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !^/api(/|$)
  RewriteRule . /index.html [L]
</IfModule>

# Compressao GZIP / Deflate para carregamento ultra rapido
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# Cache de navegador para arquivos estaticos
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
</IfModule>

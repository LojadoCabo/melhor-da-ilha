rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions & Security Pillars ---

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'filocriacoes@gmail.com' ||
        request.auth.token.admin == true
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Entity Validation Helpers ---

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt']) &&
             data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'createdAt', 'updatedAt']) &&
             data.uid == request.auth.uid &&
             data.email is string && data.email.size() <= 150 &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500)) &&
             data.createdAt is string && data.createdAt.size() <= 50;
    }

    function isValidFavorite(data) {
      return data.keys().hasAll(['businessId', 'businessName', 'businessCity', 'createdAt']) &&
             data.keys().hasOnly(['businessId', 'businessName', 'businessCity', 'categoryId', 'createdAt']) &&
             data.businessId is string && data.businessId.size() > 0 && data.businessId.size() <= 100 &&
             data.businessName is string && data.businessName.size() <= 150 &&
             data.businessCity is string && data.businessCity.size() <= 80 &&
             (!('categoryId' in data) || (data.categoryId is string && data.categoryId.size() <= 80)) &&
             data.createdAt is string && data.createdAt.size() <= 50;
    }

    function isValidReview(data) {
      return data.keys().hasAll(['businessId', 'userId', 'userName', 'rating', 'comment', 'createdAt']) &&
             data.keys().hasOnly(['businessId', 'userId', 'userName', 'userAvatar', 'rating', 'comment', 'createdAt']) &&
             data.userId == request.auth.uid &&
             data.businessId is string && data.businessId.size() <= 100 &&
             data.userName is string && data.userName.size() <= 100 &&
             (!('userAvatar' in data) || (data.userAvatar is string && data.userAvatar.size() <= 500)) &&
             data.rating is number && data.rating >= 1 && data.rating <= 5 &&
             data.comment is string && data.comment.size() >= 5 && data.comment.size() <= 1000 &&
             data.createdAt is string && data.createdAt.size() <= 50;
    }

    function isValidInquiry(data) {
      return data.keys().hasAll(['name', 'email', 'message', 'type', 'createdAt']) &&
             data.keys().hasOnly(['name', 'email', 'phone', 'businessName', 'message', 'type', 'createdAt']) &&
             data.name is string && data.name.size() >= 2 && data.name.size() <= 100 &&
             data.email is string && data.email.size() <= 150 &&
             (!('phone' in data) || (data.phone is string && data.phone.size() <= 30)) &&
             (!('businessName' in data) || (data.businessName is string && data.businessName.size() <= 120)) &&
             data.message is string && data.message.size() >= 5 && data.message.size() <= 1500 &&
             (data.type == 'advertise' || data.type == 'contact' || data.type == 'claim') &&
             data.createdAt is string && data.createdAt.size() <= 50;
    }

    function isValidChatMessage(data) {
      return data.keys().hasAll(['role', 'content', 'createdAt']) &&
             data.keys().hasOnly(['role', 'content', 'createdAt']) &&
             (data.role == 'user' || data.role == 'model') &&
             data.content is string && data.content.size() <= 8000 &&
             data.createdAt is string && data.createdAt.size() <= 50;
    }

    // --- Zero-Trust Default Deny ---
    match /{document=**} {
      allow read, write: if false;
    }

    // --- User Profiles ---
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && isValidUserProfile(incoming());
      allow delete: if isAdmin();

      // Subcollection: User Saved Favorites
      match /favorites/{businessId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(businessId) && isValidFavorite(incoming());
        allow update: if isOwner(userId) && isValidId(businessId) && isValidFavorite(incoming());
        allow delete: if isOwner(userId);
      }

      // Subcollection: User Assistant Chat Messages
      match /chats/{chatId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(chatId) && isValidChatMessage(incoming());
        allow update: if isOwner(userId) && isValidId(chatId) && isValidChatMessage(incoming());
        allow delete: if isOwner(userId);
      }
    }

    // --- Business Reviews ---
    match /businesses/{businessId}/reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated() &&
                    isValidId(reviewId) &&
                    isValidReview(incoming()) &&
                    incoming().businessId == businessId;
      allow update: if isAuthenticated() &&
                    isValidId(reviewId) &&
                    existing().userId == request.auth.uid &&
                    isValidReview(incoming()) &&
                    incoming().userId == request.auth.uid;
      allow delete: if isAuthenticated() &&
                    (existing().userId == request.auth.uid || isAdmin());
    }

    // --- Leads & Inquiries (Advertise & Contact) ---
    match /inquiries/{inquiryId} {
      allow create: if isValidId(inquiryId) && isValidInquiry(incoming());
      allow read, update, delete: if isAdmin();
    }
  }
}
